NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/study_planner?schema=public"
# Only needed with a pooled connection (e.g. Neon on Vercel) — see prisma/schema.prisma.
# Point this at the same local database in dev; DATABASE_URL is already unpooled here.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/study_planner?schema=public"
JWT_ACCESS_SECRET=change-me-access-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:5173
# Required only for the Vercel Cron-triggered /api/cron/notifications endpoint.
CRON_SECRET=change-me-cron-secret
